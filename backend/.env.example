# ==========================================
# Open-FDD Backend Environment Variables
# ==========================================

# Comma-separated list of allowed frontend CORS origins
# For local dev: http://localhost:3000,http://127.0.0.1:3000
# For production Render: https://YOUR-VERCEL-DOMAIN.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage Directories (defaults to local data/ directory if omitted)
# For Render Persistent Disk mounted at /var/data:
# OPENFDD_UPLOAD_DIR=/var/data/uploads
# OPENFDD_STORAGE_DIR=/var/data/historian
# OPENFDD_PARQUET_ROOT=/var/data/historian
OPENFDD_UPLOAD_DIR=
OPENFDD_STORAGE_DIR=
OPENFDD_PARQUET_ROOT=
